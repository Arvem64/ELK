##################### Certificates Generation ############################################
#Creation of certificates for use with Transport Layer Security (TLS) in the Elastic Stack:

#Generating a new certificate authority (CA) in PEM format (unencrypted private key):

cd /usr/share/elasticsearch/bin
./bin/elasticsearch-certutil ca --out /etc/pki/tls/certs/elastic-ca.zip --pem

unzip /etc/pki/tls/certs/elastic-ca.zip -d /etc/pki/tls/certs/elastic-ca

#if you are not sure where it is, run the command: find / -name "elasticsearch-certutil" 2>/dev/null

---------------------------------------------------------------------
Generating a certificate authority (CA) in PEM format (encrypted private key):

openssl ran -base64 32> /etc/pki/tls/private/ca_tls_passphrase.txt
chmod 600 /etc/pki/tls/private/ca_tls_passphrase.txt

systemd-creds encrypt /etc/pki/tls/private/ca_tls_passphrase.txt /etc/pki/tls/private/ca_tls_passphrase.cred

rm /etc/pki/tls/private/ca_tls_passphrase.txt

./bin/elasticsearch-certutil ca \
--pass "$(systemd-creds decrypt /etc/pki/tls/private/ca_tls_passphrase.cred -)" \
--out /etc/pki/tls/certs/elastic-ca.zip --pem

#ca.key's passphrase decrypted manually via systemd-creds decrypt, since there's no "CA service" => signing a cert is a one-off admin command

#switch from "CN= Elastic Certificate Tool Autogenerated CA" to --ca-dn "CN=Elastic-Internal-CA", if the canonical name's change is necessary

---------------------------------------------------------------------
Generating the logstash certificate, signed by that CA in PEM format:

./bin/elasticsearch-certutil cert --ca-cert /etc/pki/tls/certs/elastic-ca/ca.crt \
--ca-key /etc/pki/tls/private/elastic-ca/ca.key \
--ca-pass "$(systemd-creds decrypt /etc/pki/tls/private/ca_tls_passphrase.cred -)" \
--name logstash --dns elk-srv --out /etc/pki/tls/certs/logstash-cert.zip --pem

unzip /etc/pki/tls/certs/logstash-cert.zip -d /etc/pki/tls/certs/logstash

#--dns= the elastic server's hostname reachable on LAN

-----------------------------------------------------------------------
Generating the nginx_identity certificate (unencrypted nginx_identity private key), signed by that CA in PEM format:

./bin/elasticsearch-certutil cert --ca-cert /etc/pki/tls/certs/elastic-ca/ca.crt \
--ca-key /etc/pki/tls/private/elastic-ca/ca.key \
--ca-pass "$(systemd-creds decrypt /etc/pki/tls/private/ca_tls_passphrase.cred -)" \
--name nginx_identity --dns elk-srv --out /etc/pki/tls/certs/nginx_identity-cert.zip --pem

unzip /etc/pki/tls/certs/nginx_identity-cert.zip -d /etc/pki/tls/certs/nginx_identity

#--dns= the elastic server's hostname reachable on LAN, used to connect to nginx

----------------------------------------------------------------------
Generating the kibana_identity certificate, signed by that CA in PEM format:

./bin/elasticsearch-certutil cert --ca-cert /etc/pki/tls/certs/elastic-ca/ca.crt \
--ca-key /etc/pki/tls/private/elastic-ca/ca.key \
--ca-pass "$(systemd-creds decrypt /etc/pki/tls/private/ca_tls_passphrase.cred -)" \
--name kibana_identity --dns localhost --ip 127.0.0.1 --out /etc/pki/tls/certs/kibana_identity-cert.zip --pem

unzip /etc/pki/tls/certs/kibana_identity-cert.zip -d /etc/pki/tls/certs/kibana_identity

#--dns= localhost and --ip= 127.0.0.1 used by nginx to connect to kibana

