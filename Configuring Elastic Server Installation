########### Creating a custom index_template ######################

###alias must be configured in the index template and ILM setup:

#step 1- create the ILM policy to roll over an index
#------------------------------------------------------------------------- 
PUT _ilm/policy/logs-30-days

{
  "policy": {
     "phases": {

         "hot": {
           "actions": {
             "rollover": {
                "max_primary_shard_size": "50gb",
                "max_age": "30d"
               }
            }
         },
 
        "delete": {
          "min_age": "30d",
          "actions": {
            "delete": {}
          }
        }
      }
    }
 }

#apply "policy" in these 2 phases "hot" and "delete":
##in the "hot" phase (logs are actively written and frequently accessed): apply "rollover" "actions"
###rollover switches writes to a new backing index when a configured condition is reached
##in the "delete" phase (logs are deleted when their retention period expires): check "min_age" and apply "delete" "actions"
###delete removes old indices according to the retention policy
#shard: a part of an elasticsearch index where docs are stored
#-------------------------------------------------------------------------
#step 2- create the index template

PUT _index_template/logstash_template
{
  #apply the template to matching indices
  ##logstash-* here is a pattern not an actual index, it matches indices whose names start with logstash-, such as logstash-000001 and logstash-000002
  "index_patterns" : ["logstash-*"],

  "template": {
     "settings": {
         
         #select ILM policy
         "index.lifecycle.name": "logs-30-days",

         #tells ILM which alias to roll over
         "index.lifecycle.rollover_alias": "logstash"
      }
   },
   
  "priority" : 200
}

#"priority" : 200 = determine which index template elasticsearch chooses when multiple templates match the same index
##if two index templates can match the same index because their patterns overlap:
  #template A = "index_patterns" : ["logstash-*"] => "priority": 200
  #template B = "index_patterns" : ["logstash-000*"] => "priority": 100
##both match logstash-000001 => given priority => select A

#/////////////////////////////////////////////////////////////
#when logstash-000002 is created after rollover, elasticsearch can apply the matching template settings automatically:

###which indices: logstash-*
###which ILM policy: logs-30-days
###which rollover alias: logstash
#-------------------------------------------------------------------------
#step 3- create the first backing index

#create the 1st index and attach the alias as its write alias
 
PUT logstash-000001
{
  "aliases": {
     "logstash":{
        "is_write_index": true
     }
   }
}
