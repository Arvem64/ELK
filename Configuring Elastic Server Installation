#Configuring Nginx over SSL:

vi /etc/nginx/conf.d/elk-srv.conf

server {

     #Configure SSL on port 443:
     #listen 443 ssl;

     #Configure SSL on a specific address [Private-IP@]:443 :: this guarantees Nginx completely ignores requests coming from WAN interface
     listen 10.0.0.11:443 ssl;

     #users access https://elk-srv or internal subdomain FQND:: https://es_node1.internal.company.com

     server elk-srv, es_node1.internal.company.com;

     #the public cert that Nginx presents to the browser (LAN Client) -- if users access https://elk-srv or es_node1.internal.company.com then, the cert should contain SAN=DNS:elk-srv and es_node1.internal.company.com:
     #!create symbolic links to the certificates and keys
     ssl_certificate /etc/nginx/certs/nginx_identity.crt;

     #the private key is permanently stored within the server:
     ssl_certificate_key /etc/nginx/certs/nginx_identity.key;

     #recommended: passphrase stored in plaintext to the tmpfs file, to decrypt the encrypted private key:
     ssl_password_file /run/credentials/nginx.service/nginx_tls_passphrase;

     #tells nginx where to find the passphrase for its encrypted TLS private key and the file must have chmod 400 -- read-only:
     #!passphrase is in plaintext:
     #ssl_password_file /etc/nginx/nginx_tls_passphrase.txt;

     #ssl protocols:
     ssl_protocols TLSv1.2 TLSv1.3;
    
     #basic authentication to authenticate Nginx to Kibana:
     auth_basic "Restricted Access";

     #the hidden file where the credentials hashes are stored:
     auth_basic_user_file /etc/nginx/.kibana-user;
  
     ###Reverse proxy --> Kibana
     #for requests to / and everything underneath (/ /login /app /api /socket), apply these proxy rules:

     location / {

         #reverse proxy(enabling TLS on both sides, browser <=> kibana, we configure the other side on kibana.yml)
         proxy_pass https://127.0.0.1:5601;
         
 	     #CA used to verify Kibana's certificate, move CA certificate to /etc/nginx/certs/: 
         proxy_ssl_trusted_certificate /etc/nginx/certs/ca.crt;
         
     	 #enable nginx to verify the cert presented by Kibana:
         proxy_ssl_verify on;
    
      	 #verifing the SSL/TLS certificate, we should go back up the chain of trust until we reach a self-signed Root Certificate Authority (CA), in this specific case, we defined two CAs, which is more than enough, since we signed the cert with Elastic CA = Level 1:
         proxy_ssl_depth 2;
         
         #http version == nginx uses http/1.1 when communicating with kibana:
         proxy_http_version 1.1;

	     #header host == forward the host received by nginx to kibana running on localhost: browser::host=elk-srv -- nginx --> kibana::host=elk-srv:
	     proxy_set_header Host $host;

 	     #forward the Client's IP@ to kibana, e.g., a remote machine with IP@=10.0.0.22 connected to nginx:: X-Real-IP = 10.0.0.22, without this, the backend(kibana) may only see the proxy's address:
       	 proxy_set_header X-Real-IP $remote_addr;
         
         #this preserves the client IP through proxy chain, it means, keep any existing X-Forwarded-For and add the current client's @IP:
 	     ##if there is no proxy/load balancer before nginx, the X-Forwarded-For forwarded to kibana stays the same as the X-Real-IP:
         ##if there is a proxy/load balancer before nginx, and e.g., its IP@=192.168.2.5 & the remote machine 10.0.0.22, the X-Real-IP then will turn into 192.168.2.5(because it will be the remote IP@ to nginx -linked directly to it-) and it will be appended in the right side of the header by nginx where the original client IP 10.0.0.22 is already stored. So, X-Forwarded-For = 10.0.0.22, 192.168.2.5 will be passed to kibana :
       	 proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

	     #protocol fowarded to kibana:: $scheme= https
         proxy_set_header X-Forwarded-Proto $scheme;

         #forward the connection upgrade to kibana = did the client ask to upgrade the connection to "$http_upgrade = Websocket" instead of keeping it a normal HTTP (this protocol allows the server to push information to the browser without this later repeatedly asking, unlike the HTTP protocol, the server waits for the client's request and the connection terminates when the server sends the response = both can send data to each other):
         proxy_set_header Upgrade $http_upgrade;

	     #forward the "Upgrade" value of the previous line to kibana:
	     proxy_set_header Connection "upgrade";

         #bypass the cache if the connection upgarde is "Websocket" because it a live connection = it tells nginx to not fetch responses from the cache:		 								
	     proxy_cache_bypass $http_upgrade;

     }
}
