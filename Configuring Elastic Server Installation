    ssl_enabled => true
    #logstash trusts that issuing CA
    ssl_certificate_authorities => ["/etc/logstash/certs/Elastic-Internal_CA.crt"]
    
    #create a daily index based on the log-shipper agent's name == "filebeat-version-date" 
    ##use the "index" option, if "ilm_enabled => false"
    ##each day an index will be created: e.g. "filebeat-9.5.5-2026.10.06"
    #index => "%{[@metadata][beat]}-%{[@metadata][version]}-%{+YYYY.MM.dd}"
 
    #the elasticsearch account "logstash" uses to log in
    user => "logstash_internal"
    #logstash retrieves the password from its keystore variable LE_PASSWORD
    password => ${LE_PASSWORD}

    #####recommended: in case of using ILM (Index Lifecycle Management) to automatically manage indices through phases such as hot, warm, cold, frozen and delete:
    #enable ILM with its default setup (no custom index_template created) 
    ilm_enabled => true

    #-------------------------------------------------------------
    ###in case of using a custom ILM settings:: add the following:
    ##index template: set of rules elasticsearch automatically applies when creating a new index 
    
    #specify the alias logstash uses to write docs to
    ##backing-name names must match the role's index pattern
    ##rollover alias must be configured in the index template
    ##alias must be configured in the index template and ILM policy setup
    ilm_rollover_alias => "logstash"
    
    #start the backing-index (rollover_alias-pattern) naming sequences at "logstash-000001"
    #logstash requests elasticsearch to create "logstash-000001" => ES checks logstash's create_index permission (_security/role/ privileges) => if authorized::ES creates the index 
    #indices: write docs to logstash-000001 until ILM policy is reached, then swipe to logstash-000002 (rollover) and so on
    ilm_pattern => "000001"

    #specify the ILM policy name
    ilm_policy => "logs-30-days"

    #prevent logstash from managing the index_template given that we use a custom one
    manage_template => false
    #------------------------------
  }
}

