Configure Kibana Authentication

Update /etc/kibana/kibana.yml

server.port: 5601
server.host: "localhost" #(LAN IP@ or 0.0.0.0)
elasticsearch.hosts: ["https://localhost:9200"]
server.name: "kibana"
elasticsearch.username: "kibana_system"
elasticsearch.password: "password"

#Elasticsearch's automatic security setup generates the HTTP CA when it starts for the first time, so copy it to the kibana's certs folder: sudo cp /etc/elasticsearch/certs/http_ca.crt /etc/kibana/certs/
elasticsearch.ssl_certificateAuthorities: ["/etc/kibana/certs/http_ca.crt"]

logging.root.level: info #(which type of logs to display. Minimum log level. One of debug, info, warning, or error. The default log level is info)

systemctl restart kibana

#Otherwise, run /usr/share/elasticsearch/bin/elasticsearch-certutil http
#be sure you select N to "Generate a CSR" (Certificate signing request to be sent to a trusted external or internal CA for signing) to generate a CRT instead, and Y to "using an existing CA" if you already created a CA for your cluster, when prompting
#it's recommended by Elastic to use the existing HTTP_CA certificate
