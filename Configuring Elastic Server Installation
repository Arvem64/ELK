  elasticsearch {
  
    #######logstash + elasticsearch:: HTTPS +  http basic authentication#######

    hosts => ["https://elk-srv:9200"]
    
    #in case of multiple nodes (hostnames and their own IPs or aliases are allowed)
    #each endpoint must pass TLS certificate verification
    #hosts => ["https://elk-srv:9200", "https://es_node1.internal.company.com:9200", "https://10.0.0.11:9200", "https://10.0.0.12:9200", "https://10.0.0.13:9200"]
    
