  #password in plaintext, so we use HTTPS to protect it while it travels to Elasticsearch
  #elasticsearch stores it as a secure hash

  "password" : "x-pack-test-password",
  "roles" : ["logstash_writer"],
  "full_name" : "Internal Logstash User"
