other method to generate session keys with python:

from cryptography.hazmat.primitives.asymmetric import x25519
from cryptography.hazmat.primitives.hashes import SHA256
from cryptography.hazmat.primitives.kdf.hkdf import HKDF

#load browser's private key (64 hex characters)
prvt_hex = "e4b3f774b52b8b86f680020862e9e9576823a7b38ffa32cf47432ee5b7d29f38"
prvt = x25519.X25519PrivateKey.from_private_bytes(bytes.fromhex(prvt_hex))

#load the received server's public key
pblc_hex = "ca2c0fa02f2f8e71898ffb2dadb9b11cacf59115b742e55538c8f177fed7a0c3"
pblc = x25519.X25519PublicKey.from_public_bytes(bytes.fromhex(pblc_hex))

#perform (a X B mod p) Elliptic curve multiplication loop
raw_shared_secret = prvt.exchange(pblc)

#derivation step: standard TLS 1.3 HKDF expansion to create the 256-bit AES-GCM key
hkdf = HKDF(
     algorithm=SHA256()
     length=32 #32 bytes = 256 bits
     salt=None,
     info=b"tls13 client application traffic secret" #context label
) 

final_session_key = hkdf.derive(raw_shared_secret)

print("256-bit AES-session key:",final_session_key.hex())

*************************************
x25519 = python module (file/folder)
X25519PrivateKey = a class representing a secret X25519 private key, which is used in elliptic-curve Diffie-Hellman (ECDH) key exchanges to establish a shared secret
from_private_bytes() = a constructor method that load the binary bytes (32 bytes for X25519) and converts them into an executable X25519PublicKey object so python can perform mathematical cryptographic operations on them
X25519PublicKey = a class representing an X25519 public key, which is used in elliptic-curve Diffie-Hellman (ECDH) key exchanges to establish a shared secret
from_public_bytes() = a constructor method that load the binary bytes (32 bytes for X25519) and instantiates them into an executable X25519PublicKey object
object.bytes.fromhex() = a built-in python function that converts a string of hexadecimal characters into standard raw binary (bytes)
exchange() = it multiplies the private key by the received public key to calculate the raw shared secret
#HKDF() = HMAC-based Extract-and-Expand Key Derivation Function. It takes a raw structured shared secret and cleans it into a perfectly random cryptography key suitable for symmetric encryption like AES
#salt=none:: a random string of 0 used to make te key derivation even stronger 
#info=b"..." a context label that binds the resulting key to a specific purpose so that the same shared secret can't accidentally produce the exact same key for a different application protocol
#b prefix : it tells python to treat the string as a bytes literal instead of regular text string, as cryptographic functions only accept raw binary data
#derive() = run the raw shared secret through the HMAC of the HDKF and generate the final 256-bit AES session key

