!Additional:: IN CASE OF: Static NAT

!Map private port 5044 to public port 5044
Router(config)# ip nat inside static source tcp [PRIVATE-IP] 5044 [PUBLIC-IP] 5044

!in case of one port linked to Outside-Interface:
Router(config)# ip nat inside source static tcp [PRIVATE-IP] [PRIVATE-PORT] interface GigabitEthernet0/0 [PUBLIC-PORT]


!in case of range of ports (for distinct cases) and the router supports the Object Group option:
!create a service group for the port range
Router(config)# object-group RANGE_PORTS tcp
Router(config-object-group)# port-range 5044-5045
Router(config-object-group)# exit

!apply the object group to the static translation rule
Router(config)# ip nat inside source static tcp PRIVATE-IP@ service RANGE_PORTS interface GigabitEthernet0/0 service RANGE_PORTS

!show ip nat table
Router# show ip nat translations
